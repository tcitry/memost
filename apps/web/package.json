{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/logs vite --host 0.0.0.0 --port 3000",
    "build": "WRANGLER_LOG_PATH=.wrangler/logs vite build",
    "build:prod": "CLOUDFLARE_ENV=production WRANGLER_LOG_PATH=.wrangler/logs vite build",
    "start": "WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --port 3000",
    "deploy": "pnpm build && WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy",
    "deploy:prod": "pnpm build:prod && WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --env production",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "WRANGLER_LOG_PATH=.wrangler/logs wrangler d1 migrations apply memost-db-dev --local",
    "db:migrate:remote": "WRANGLER_LOG_PATH=.wrangler/logs wrangler d1 migrations apply memost-db-dev --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@clerk/tanstack-react-start": "^1.2.5",
    "@repo/design-system": "workspace:*",
    "@tanstack/react-router": "^1.170.4",
    "@tanstack/react-start": "^1.168.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.536.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.4",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/router-plugin": "^1.168.6",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9.2",
    "vite": "^7.2.7",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.90.1"
  }
}
