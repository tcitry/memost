{
  "name": "api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/logs wrangler dev --port 8787",
    "build": "WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --outdir dist",
    "deploy": "WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy",
    "deploy:prod": "WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --env production",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "cf-typegen": "WRANGLER_LOG_PATH=.wrangler/logs wrangler types"
  },
  "dependencies": {
    "@hono/clerk-auth": "^3.1.1",
    "hono": "^4.12.18"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "typescript": "5.9.2",
    "wrangler": "^4.90.1"
  }
}
