{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "memost-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "memost-api.iuvdev.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "MEMOST_ENV": "development",
    "VECTOR_DIMENSIONS": "1024",
    "EMBEDDING_MODEL": "@cf/baai/bge-large-en-v1.5",
    "KG_LLM_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "CLERK_PUBLISHABLE_KEY": "pk_test_c2hhcnAtYmlyZC00Ni5jbGVyay5hY2NvdW50cy5kZXYk",
    "CLERK_OAUTH_TOKEN_INTROSPECTION_URL": "https://sharp-bird-46.clerk.accounts.dev/oauth/token_info"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memost-db-dev",
      "database_id": "04c61e32-2e5f-4e93-9458-0c921eb1c92f",
      "migrations_dir": "migrations"
    },
    {
      "binding": "BENCHMARK_DATASET_DB",
      "database_name": "memost-std-benchmark-dataset",
      "database_id": "2d840e83-dcab-4537-adb2-5df631366f00",
      "preview_database_id": "2d840e83-dcab-4537-adb2-5df631366f00",
      "remote": true
    }
  ],
  "vectorize": [
    {
      "binding": "MEMORY_INDEX",
      "index_name": "memost-vector-dev",
      "remote": true
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVAL_QUEUE",
        "queue": "memost-eval-dev"
      }
    ],
    "consumers": [
      {
        "queue": "memost-eval-dev",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "dead_letter_queue": "memost-eval-dlq-dev",
        "retry_delay": 60
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "env": {
    "production": {
      "name": "memost-api-prod",
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      },
      "workers_dev": false,
      "routes": [
        {
          "pattern": "api.memo.st",
          "custom_domain": true
        }
      ],
      "vars": {
        "MEMOST_ENV": "production",
        "VECTOR_DIMENSIONS": "1024",
        "EMBEDDING_MODEL": "@cf/baai/bge-large-en-v1.5",
        "KG_LLM_MODEL": "@cf/meta/llama-3.1-8b-instruct",
        "CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsubWVtby5zdCQ",
        "CLERK_OAUTH_TOKEN_INTROSPECTION_URL": "https://clerk.memo.st/oauth/token_info"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "memost-db-prod",
          "database_id": "7e536830-1033-4ac5-ad60-6cbc3eaa4bcc",
          "migrations_dir": "migrations"
        },
        {
          "binding": "BENCHMARK_DATASET_DB",
          "database_name": "memost-std-benchmark-dataset",
          "database_id": "2d840e83-dcab-4537-adb2-5df631366f00",
          "preview_database_id": "2d840e83-dcab-4537-adb2-5df631366f00",
          "remote": true
        }
      ],
      "vectorize": [
        {
          "binding": "MEMORY_INDEX",
          "index_name": "memost-vector-prod",
          "remote": true
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVAL_QUEUE",
            "queue": "memost-eval-prod"
          }
        ],
        "consumers": [
          {
            "queue": "memost-eval-prod",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "dead_letter_queue": "memost-eval-dlq-prod",
            "retry_delay": 60
          }
        ]
      },
      "ai": {
        "binding": "AI"
      }
    }
  }
}
