{
  "name": "memost",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "check-types": "turbo run check-types",
    "dataset:build-locomo": "node scripts/build-locomo-dataset-sql.mjs",
    "dataset:upload-locomo": "node scripts/upload-locomo-dataset.mjs",
    "dataset:build-longmemeval": "node scripts/build-longmemeval-dataset-sql.mjs",
    "dataset:upload-longmemeval": "node scripts/upload-longmemeval-dataset.mjs"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.12",
    "typescript": "5.9.2",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
