---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const docs = (await getCollection("docs")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="memo.st docs"
  description="Documentation for memo.st Agent memory infrastructure."
>
  <main>
    <section class="hero">
      <p class="eyebrow">Static documentation for Agent memory</p>
      <h1>Build memory-aware agents on memo.st.</h1>
      <p class="lede">
        Guides, API references, and Cloudflare runtime notes for the memo.st
        Agent memory SaaS. Content lives in MDX so product and engineering docs
        can grow without changing the app shell.
      </p>
    </section>

    <section class="content-shell doc-grid" aria-label="Documentation">
      {
        docs.map((doc) => (
          <a class="doc-card" href={`/docs/${doc.id}/`}>
            <h2>{doc.data.title}</h2>
            <p>{doc.data.description}</p>
          </a>
        ))
      }
    </section>
  </main>
</BaseLayout>
